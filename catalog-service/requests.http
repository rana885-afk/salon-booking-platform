### 1. Register an owner candidate (auth-service)
POST http://localhost:3001/auth/register
Content-Type: application/json

{
  "name": "Salon Owner",
  "email": "owner@salon.com",
  "password": "123456",
  "role": "customer"
}

### 2. Login as owner
# @name ownerLogin
POST http://localhost:3001/auth/login
Content-Type: application/json

{
  "email": "owner@salon.com",
  "password": "123456"
}

### 3. Login as customer (Rana)
# @name customerLogin
POST http://localhost:3001/auth/login
Content-Type: application/json

{
  "email": "rana222400@bue.edu.eg",
  "password": "123456"
}

### 4. Create salon (owner) -> 201
POST http://localhost:3002/salons
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "name": "Glow Salon",
  "address": "12 Tahrir St",
  "city": "Cairo",
  "latitude": 30.0444,
  "longitude": 31.2357
}

### 5. Create salon (no token) -> 401
POST http://localhost:3002/salons
Content-Type: application/json

{
  "name": "Fake",
  "address": "x",
  "city": "Cairo"
}

### 6. Create salon (customer token) -> 403
POST http://localhost:3002/salons
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.token}}

{
  "name": "Fake",
  "address": "x",
  "city": "Cairo"
}

### 7. Create salon (missing fields) -> 400
POST http://localhost:3002/salons
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "name": "No address"
}

### 8. List salons -> 200
GET http://localhost:3002/salons

### 9. Search by city -> 200
GET http://localhost:3002/salons?city=cairo

### 10. Search with bad rating -> 400
GET http://localhost:3002/salons?minRating=abc

### 11. Add service (owner) -> 201
POST http://localhost:3002/salons/1/services
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "name": "Haircut",
  "price": 150,
  "duration_minutes": 45
}

### 12. Add service (customer token) -> 403
POST http://localhost:3002/salons/1/services
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.token}}

{
  "name": "Haircut",
  "price": 150,
  "duration_minutes": 45
}

### 13. Add service (no token) -> 401
POST http://localhost:3002/salons/1/services
Content-Type: application/json

{
  "name": "Haircut",
  "price": 150,
  "duration_minutes": 45
}

### 14. Add service (negative price) -> 400
POST http://localhost:3002/salons/1/services
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "name": "Bad",
  "price": -5,
  "duration_minutes": 45
}

### 15. Add service (salon does not exist) -> 404
POST http://localhost:3002/salons/9999/services
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "name": "Haircut",
  "price": 150,
  "duration_minutes": 45
}

### 16. List services -> 200
GET http://localhost:3002/salons/1/services

### 17. Search salons by service -> 200
GET http://localhost:3002/salons?service=hair

### 18. Add stylist (owner) -> 201
# @name createStylist
POST http://localhost:3002/salons/1/stylists
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "name": "Sara"
}

### 19. Add stylist (customer token) -> 403
POST http://localhost:3002/salons/1/stylists
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.token}}

{
  "name": "Fake"
}

### 20. List stylists -> 200
GET http://localhost:3002/salons/1/stylists

### 21. Set working hours (owner) -> 200
PUT http://localhost:3002/stylists/{{createStylist.response.body.id}}/working-hours
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "hours": [
    { "weekday": 1, "start_time": "09:00", "end_time": "17:00" },
    { "weekday": 2, "start_time": "09:00", "end_time": "17:00" },
    { "weekday": 3, "start_time": "10:00", "end_time": "18:00" }
  ]
}

### 22. Set working hours (end before start) -> 400
PUT http://localhost:3002/stylists/{{createStylist.response.body.id}}/working-hours
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "hours": [
    { "weekday": 1, "start_time": "17:00", "end_time": "09:00" }
  ]
}

### 23. Set working hours (customer token) -> 403
PUT http://localhost:3002/stylists/{{createStylist.response.body.id}}/working-hours
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.token}}

{
  "hours": []
}

### 24. Set working hours (stylist does not exist) -> 404
PUT http://localhost:3002/stylists/9999/working-hours
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.token}}

{
  "hours": []
}

