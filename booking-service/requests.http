{ "status": "confirmed" }

### 33. Cancel my appointment (more than 24 hours away) -> 204
# Run this AFTER the status tests above, because it cancels appointment 4
DELETE http://localhost:3004/appointments/4
Authorization: Bearer {{customerLogin.response.body.token}}

### 34. Cancel the same appointment again -> 403
DELETE http://localhost:3004/appointments/4
Authorization: Bearer {{customerLogin.response.body.token}}

### 35. Cancel an appointment that starts in 2 hours -> 403
DELETE http://localhost:3004/appointments/99
Authorization: Bearer {{customerLogin.response.body.token}}

