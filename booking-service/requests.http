### 41. Reschedule to Tuesday 10:00 next week -> 200
# Replace 5 with the id of a pending/confirmed appointment of yours
PUT http://localhost:3004/appointments/5
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.token}}

{
  "start_time": "2026-12-08T10:00:00Z"
}

