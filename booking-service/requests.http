### 1. Login as customer (Rana)
# @name customerLogin
POST http://localhost:3001/auth/login
Content-Type: application/json

{
  "email": "rana222400@bue.edu.eg",
  "password": "123456"
}

### 2. Login as owner
# @name ownerLogin
POST http://localhost:3001/auth/login
Content-Type: application/json

{
  "email": "owner@salon.com",
  "password": "123456"
}

### 3. Login as stylist (Sara)
# @name stylistLogin
POST http://localhost:3001/auth/login
Content-Type: application/json

{
  "email": "sara@salon.com",
  "password": "123456"
}

### 4. Book (valid, Tuesday 09:00) -> 201
POST http://localhost:3004/appointments
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.token}}

{
  "salon_id": 1,
  "stylist_id": 1,
  "service_id": 1,
  "start_time": "2026-12-01T09:00:00Z"
}

### 5. Book (same slot again) -> 409
